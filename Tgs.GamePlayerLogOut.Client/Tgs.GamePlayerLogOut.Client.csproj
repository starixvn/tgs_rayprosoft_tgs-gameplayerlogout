<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net7.0;net8.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<Version>1.0.0</Version>
		<Authors>Raypro</Authors>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gameplayerlogout</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gameplayerlogout.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<RootNamespace>Tgs.GamePlayerLogOut.Client</RootNamespace>
		<PackageId>Tgs.GamePlayerLogOut.Client</PackageId>
		<Title>Tgs.GamePlayerLogOut.Client</Title>
		<Description>Tgs.GamePlayerLogOut.Client</Description>
		<PackageTags>Tgs GamePlayerLogOut Client</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="PhoenixToolkits.MessageQueue" Version="2.2.0" />
		<PackageReference Include="PhoenixToolkits.NuGet.BuildTools" Version="0.0.3">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Tgs.GamePlayerLogOut.Common\Tgs.GamePlayerLogOut.Common.csproj">
			<PrivateAssets>all</PrivateAssets>
		</ProjectReference>
	</ItemGroup>

</Project>